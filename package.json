{
  "name": "fitlog",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "expo start -c",
    "android": "expo start -c --android",
    "ios": "expo start -c --ios",
    "web": "expo start -c --web",
    "clean": "rm -rf .expo node_modules",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "check:arch": "node scripts/check-architecture.mjs",
    "db:start": "npx -y supabase@3.0.0 start",
    "db:reset": "npx -y supabase@3.0.0 db reset",
    "db:types": "npx -y supabase@3.0.0 gen types typescript --local > lib/database.types.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/portal": "~1.4.0",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~56.0.13",
    "expo-constants": "~56.0.19",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.12",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.11",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "lucide-react-native": "^1.21.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.8.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
